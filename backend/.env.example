# --- Mochi backend configuration ---
# Copy to `.env` and fill in real values. Never commit `.env`.

# Environment: dev | prod (switches SQLite vs Postgres fallback behavior)
MOCHI_ENV=dev

# Database
# dev  -> DATABASE_URL=sqlite:///./mochi.db
# prod -> DATABASE_URL=postgresql+psycopg2://mochi:CHANGE_ME@db:5432/mochi
DATABASE_URL=sqlite:///./mochi.db

# Auth: used to sign device JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_please_use_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=90

# LLM providers used by the cloud task executor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# GitHub default bot account
MOCHI_DEFAULT_GITHUB_TOKEN=

# CORS: comma separated origins allowed to talk to the REST API (Android app, web)
CORS_ORIGINS=http://localhost:3000